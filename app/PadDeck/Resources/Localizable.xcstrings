    "Modifiers: cmd, shift, ctrl, opt, fn. Keys: letters, numbers, space, tab, return, esc, delete, up/down/left/right, f1–f12.": {
      "extractionState": "manual",
      "localizations": {
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Modificadores: cmd, shift, ctrl, opt, fn. Teclas: letras, números, space, tab, return, esc, delete, up/down/left/right, f1–f12."
          }
        }
